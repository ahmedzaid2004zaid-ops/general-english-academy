    mr.onstop=()=>{st.getTracks().forEach(x=>x.stop());clearTimeout(to);$("r"+i).disabled=false;$("x"+i).disabled=true;$("ps"+i).disabled=true;$("ps"+i).textContent="⏸ Pause";
     if(ch.length)saved(i,new Blob(ch,{type:mr.mimeType||mime||"audio/webm"}));else t.textContent=" Nothing was recorded. Try again."};
    mr.start(250);$("r"+i).disabled=true;$("x"+i).disabled=false;$("ps"+i).disabled=false;t.textContent=" Recording…";to=setTimeout(()=>mr.state!=="inactive"&&mr.stop(),120000)
   }catch(e){const m={NotAllowedError:"Microphone is blocked. Click the 🔒 icon next to the page address, set Microphone to Allow, then reload. If the page is inside another site, the iframe needs allow=\"microphone\" / الميكروفون محجوب: اضغط أيقونة القفل بجانب الرابط واختر Allow ثم حدّث الصفحة",NotFoundError:"No microphone found / لا يوجد ميكروفون",NotReadableError:"Microphone is being used by another app / الميكروفون مستخدم في تطبيق آخر",SecurityError:"Blocked by the site’s permission policy – usually because the test is shown inside another page (iframe) that does not allow the microphone. Open the test in its own browser tab, or ask the site owner to add the attribute allow=microphone to the iframe / الميكروفون محظور لأن الاختبار معروض داخل صفحة أخرى (iframe) بدون إذن الميكروفون. افتح الاختبار في تبويب مستقل"}[e.name]||"Could not start recording";
    failMsg(t,m+" ["+e.name+"]. You can use Upload below / يمكنك استخدام رفع تسجيل.")}};
  $("x"+i).onclick=()=>mr&&mr.state!=="inactive"&&mr.stop();
  $("ps"+i).onclick=()=>{if(!mr)return;if(mr.state==="recording"){mr.pause();$("ps"+i).textContent="▶ Resume";$("t"+i).textContent=" Paused"}else if(mr.state==="paused"){mr.resume();$("ps"+i).textContent="⏸ Pause";$("t"+i).textContent=" Recording…"}}});
 $("sub").onclick=()=>{if(Object.keys(rec).length<SPK.length&&!sure("sp")){$("sub").textContent="Some answers are missing. Tap again to submit anyway";return}si=S.length;next()}
}
