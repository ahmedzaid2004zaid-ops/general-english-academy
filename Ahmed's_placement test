function failMsg(t,m){t.textContent=" ⚠ "+m;if(window.self!==window.top&&/^(https?|file):/.test(location.protocol)){const a=document.createElement("a");a.href=location.href;a.target="_blank";a.rel="noopener";a.textContent=" ▶ Open the test in a new tab / افتح في تبويب جديد";t.appendChild(a)}}
