}
const b64=b=>new Promise((ok,no)=>{const f=new FileReader();f.onload=()=>ok(String(f.result).split(",")[1]);f.onerror=no;f.readAsDataURL(b)});
const ext=b=>{const t=b.type||"";return t.includes("mp4")||t.includes("mpeg")?"m4a":t.includes("ogg")?"ogg":t.includes("wav")?"wav":(b.name||"").split(".").pop()||"webm"};
async function sendScript(){
 const wrong=[];for(let i=1;i<=70;i++)if(ans[i]!==KEY[i-1])wrong.push(i+" ("+(ans[i]||"blank")+" → "+KEY[i-1]+")");
 const recordings=[];for(const i of Object.keys(rec)){const b=rec[i];recordings.push({name:"speaking_"+(+i+1)+"_"+result.name.replace(/\W+/g,"_")+"."+ext(b),type:b.type||"audio/webm",data:await b64(b)})}
